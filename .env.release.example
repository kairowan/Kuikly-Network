# Source this file in CI or your local release shell after replacing every value.
CATCHZOON_API_BASE_URL=https://103.242.12.10
CATCHZOON_ANDROID_KEYSTORE=/absolute/path/to/catchzoon-upload.jks
CATCHZOON_ANDROID_STORE_PASSWORD=replace-me
CATCHZOON_ANDROID_KEY_ALIAS=catchzoon-upload
CATCHZOON_ANDROID_KEY_PASSWORD=replace-me

# iOS Automatic Signing / CI archive settings are supplied to xcodebuild or an
# untracked xcconfig. Do not commit team IDs, profiles, certificates, or secrets.
CATCHZOON_IOS_DEVELOPMENT_TEAM=REPLACE_ME
